rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Records of trials claimed
    match /trials/{trialId} {
      // Allow read for authenticated users to check if their trial is already claimed
      allow read: if isSignedIn();
      // Allow creation of trial entries if signed in and valid ID
      allow create: if isSignedIn() && isValidId(trialId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is string
        && request.resource.data.validUntil is string;
      // Trials are immutable once claimed
      allow update, delete: if false;
    }

    // Sessions collection for valid user dashboards
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.email == request.auth.token.email;
      allow create: if isSignedIn() && isValidId(sessionId)
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSignedIn() && resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // Secure profiles and subscriptions: Users can only read/write their own document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow delete: if false;
      
      // Allow users to create only their own document with basic schema validation
      allow create: if isOwner(userId)
        && request.resource.data.email is string
        && (!('companyName' in request.resource.data) || request.resource.data.companyName is string)
        && (!('phone' in request.resource.data) || request.resource.data.phone is string)
        // Prevent setting sensitive statuses directly on creation to bypass payment logic
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free' || request.resource.data.plan == 'trial' || request.resource.data.plan == '')
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == 'unpaid' || request.resource.data.paymentStatus == '')
        && (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus == 'inactive' || request.resource.data.subscriptionStatus == '');

      // Allow updating only safe profile fields, strictly block modifications to sensitive fields
      allow update: if isOwner(userId)
        && (!('companyName' in request.resource.data) || request.resource.data.companyName is string)
        && (!('phone' in request.resource.data) || request.resource.data.phone is string)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyName', 'phone', 'updatedAt']);
    }
  }
}
