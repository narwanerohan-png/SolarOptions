rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Records of trials claimed
    match /trials/{trialId} {
      // Allow read for authenticated users to check if their trial is already claimed
      allow read: if isSignedIn();
      // Allow creation of trial entries if signed in and valid ID
      allow create: if isSignedIn() && isValidId(trialId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is string
        && request.resource.data.validUntil is string;
      // Trials are immutable once claimed
      allow update, delete: if false;
    }

    // Sessions collection for valid user dashboards
    match /sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.email == request.auth.token.email;
      allow create: if isSignedIn() && isValidId(sessionId)
        && request.resource.data.email == request.auth.token.email;
      allow update: if isSignedIn() && resource.data.email == request.auth.token.email;
      allow delete: if false;
    }
  }
}
