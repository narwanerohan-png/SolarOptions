{
  "version": 2,
  "rewrites": [
    {
      "source": "/__/auth",
      "destination": "https://gen-lang-client-0873083077.firebaseapp.com/__/auth"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://gen-lang-client-0873083077.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/company/:slug",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
